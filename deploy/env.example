# Copy to /etc/strategy-lab/env and lock it down:
#   sudo chown root:www-data /etc/strategy-lab/env && sudo chmod 640 /etc/strategy-lab/env
PORT=3000
# Data lives outside the code folder so code updates never touch it.
# `npm run add-data` reads this too, so run it with the same setting.
HISTORICAL_DIR=/var/lib/strategy-lab/historical
MAX_LIVE_STREAMS=50
